{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "ClinicalEvidence",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "ClinicalEvidence"
  },
  "runtimes": [
    {
      "name": "ClinicalEvidenceAgent",
      "build": "CodeZip",
      "entrypoint": "agentcore_app.py",
      "codeLocation": "./",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "PROVIDER_MODE",
          "value": "mock"
        },
        {
          "name": "ARTIFACT_DIR",
          "value": "/tmp/artifacts"
        }
      ]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}
